# Nothing here is required — with no env vars set, the app runs entirely on
# generated demo data with localStorage persistence, exactly as before.
# Set the Supabase block to switch the whole app (portfolio, watchlist,
# imported stocks) over to real, multi-device persistence — see the README's
# "Supabase persistence" section for the full setup steps.

# --- Supabase (optional) ---
# Project Settings -> Data API for the URL and anon/publishable key.
# Project Settings -> API Keys for the secret/service_role key (server-only,
# never exposed to the client — bypasses row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed once, to run `npm run migrate` against a fresh project.
# Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=

# --- Market data (optional) ---
# Free key: https://www.alphavantage.co/support/#api-key
# Enables "Fetch live data" on /admin/import. Indian equities need a .BSE
# suffix (e.g. RELIANCE.BSE) — NSE isn't supported by this provider, and the
# free tier is limited to ~25 requests/day.
ALPHA_VANTAGE_API_KEY=

# Not yet implemented — see README for the MarketDataProvider interface.
TWELVE_DATA_API_KEY=

# --- Scheduled price refresh (optional, requires Supabase) ---
# A random secret (e.g. `openssl rand -hex 24`) that authenticates calls to
# /api/cron/refresh-prices. Vercel automatically sends it as
# `Authorization: Bearer <value>` for the scheduled invocation configured in
# vercel.json — without this set, that route rejects every request.
CRON_SECRET=
